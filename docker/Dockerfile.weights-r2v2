# Adds the pinned R2-V2 release (docker/fetch_r2v2.sh) to the code-only image.
# Build with a context directory that contains weights/external/r2v2/, e.g.
#   docker build -f docker/Dockerfile.weights-r2v2 -t choiclara9/gave2-kirby:prelim-7.95236-weights-r2v2 CONTEXT_DIR
FROM choiclara9/gave2-kirby:prelim-7.95236-e2e-r2v2

COPY weights/external/r2v2/ /weights/external/r2v2/
